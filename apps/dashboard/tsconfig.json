{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "types": [
      "vitest/globals",
      "@testing-library/jest-dom"
    ],
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src"
  ]
}