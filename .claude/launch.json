{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": ["-c", "cd services/api && .venv/bin/alembic upgrade head && .venv/bin/uvicorn app.main:app --reload --port 8000"],
      "port": 8000
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/dashboard", "run", "dev"],
      "port": 5173
    }
  ]
}
