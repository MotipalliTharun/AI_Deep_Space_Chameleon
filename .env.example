# Copy to .env and fill in. Never commit the real .env (see .gitignore).

DATABASE_URL=postgresql+asyncpg://chameleon:chameleon@localhost:5432/chameleon
REDIS_URL=redis://localhost:6379/0

# Dashboard auth (docs/AUTH.md). ENVIRONMENT=staging|production refuses to boot
# unless JWT_SECRET is 32+ random chars and COOKIE_SECURE=true.
#   generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ENVIRONMENT=development
JWT_SECRET=
COOKIE_SECURE=false
ALLOW_SELF_SIGNUP=true
CORS_ORIGINS=["http://localhost:5173"]

# Hosted LLM provider (PRD §7: small model for routing, larger model for planning)
LLM_API_KEY=
LLM_ROUTING_MODEL=
LLM_PLANNING_MODEL=

# Integrations (PRD §7)
SHOPIFY_APP_API_KEY=
SHOPIFY_APP_API_SECRET=
ZENDESK_API_TOKEN=

# Observability
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
